{
  "name": "tafagent",
  "version": "0.11.0",
  "description": "31 LLM diagnostic modes with contextual guide explanations. EN/ES/FR/ZH.",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "test": "node tests/smoke.mjs && node tests/i18n_check.mjs && node tests/memory_reality.test.mjs && node tests/confidence.test.mjs && node tests/prediction_reality.test.mjs && node tests/adapter_reality.test.mjs && node tests/fit_check.test.mjs && node tests/research_studies.test.mjs && node tests/entropy_scanner.test.mjs && node tests/guide_bridge.test.mjs && node tests/research_labs.test.mjs && node tests/model_compatibility.test.mjs && node tests/resolver.test.mjs",
    "test:guide": "node tests/guide_bridge.test.mjs && node tests/guide_bridge_browser.mjs",
    "test:entropy": "node tests/entropy_scanner.test.mjs && python -m pytest tests/test_attention_entropy.py -q",
    "test:research": "node tests/research_studies.test.mjs && node tests/research_labs.test.mjs",
    "test:fitcheck": "node tests/fit_check.test.mjs",
    "test:smoke": "node tests/smoke.mjs",
    "test:adapter": "node tests/adapter_reality.test.mjs",
    "test:i18n": "node tests/i18n_check.mjs",
    "test:memreal": "node tests/memory_reality.test.mjs",
    "test:confidence": "node tests/confidence.test.mjs",
    "test:pvr": "node tests/prediction_reality.test.mjs",
    "test:formulas": "python -m pytest tests/test_taf_formulas.py -q",
    "test:models": "node tests/model_compatibility.test.mjs && node tests/model_review_browser.mjs",
    "test:resolver": "node tests/resolver.test.mjs && node tests/resolver_browser.mjs",
    "test:resolver-observations": "node tests/resolver_observations.test.mjs && node tests/resolver_observations_browser.mjs",
    "test:fitcheck-demo": "node tests/fitcheck_demo_browser.mjs",
    "test:evidence": "node tests/confidence.test.mjs && node tests/evidence_score_browser.mjs",
    "test:resolver-memory": "node tests/resolver_memory.test.mjs && node tests/resolver_memory_browser.mjs",
    "test:resolver-session": "node tests/resolver_session.test.mjs && node tests/resolver_session_browser.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://huggingface.co/spaces/karlexmarin/taf-agent"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "type": "commonjs"
}
